[Unit]
Description=Kanban Board (LAN web app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
Environment=HOME=/home/YOUR_USER
WorkingDirectory=/home/YOUR_USER/kanban-board
ExecStart=/usr/bin/node /home/YOUR_USER/kanban-board/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target